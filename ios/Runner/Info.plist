	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.610743370763-bckjsdcpvt6sg2tp8sqs8tgpe2457060</string>
			</array>
		</dict>
	</array>
